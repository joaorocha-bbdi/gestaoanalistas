    "@tanstack/react-query-persist-client": "^5.107.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
